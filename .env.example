# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=genesis_dev

# ══════════════════════════════════════════════════════════════════════════════
# AI CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# You can use the SAME provider for chat + images, or DIFFERENT providers.
# For example: Groq (free chat) + LocalAI (free local images)

# ── Chat Provider ─────────────────────────────────────────────────────────────
# Choose ONE chat provider:

# Option A: Groq (free tier, fast, recommended for dev)
AI_API_KEY=your-groq-api-key
AI_BASE_URL=https://api.groq.com/openai
AI_CHAT_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI
# AI_API_KEY=your-openai-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o

# Option C: Azure OpenAI
# AI_API_KEY=your-azure-openai-api-key
# AI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/gpt-4o
# AI_CHAT_MODEL=gpt-4o

# Option D: Ollama (fully local, run with: docker compose --profile local-ai up)
# AI_API_KEY=ollama
# AI_BASE_URL=http://ollama:11434/v1
# AI_CHAT_MODEL=llama3.2

# ── Image Provider ────────────────────────────────────────────────────────────
# Option 1: LLM generates SVG logo (default — works everywhere, no extra service needed)
# (leave IMAGE_MODEL_PROVIDER unset)

# Option 2: OpenAI DALL-E 3 (best quality, ~$0.04/image)
# IMAGE_MODEL_PROVIDER=openai
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=your-openai-api-key
# IMAGE_MODEL=dall-e-3

# Option 3: LocalAI + Stable Diffusion (Linux + NVIDIA GPU only)
# Run with: docker compose --profile local-images up
# NOT supported on Mac Apple Silicon (Docker emulation crashes the SD backend)
# IMAGE_MODEL_PROVIDER=openai
# IMAGE_BASE_URL=http://localai:8080/v1
# IMAGE_API_KEY=not-needed
# IMAGE_MODEL=sd-1.5-ggml
